# ============================================================================
# Plantilla de entorno para el despliegue Dockerizado (Amazon Lightsail / QA).
# No usar para desarrollo local rapido: para eso usa .env.example (SQLite).
#
# Copiar a .env en el servidor y reemplazar todos los CHANGE_ME antes de
# correr `docker compose up -d`. Este mismo archivo lo leen a la vez:
#   - Laravel (via php artisan / el contenedor "app")
#   - docker-compose.yml (sustituye ${VARIABLE} al levantar mysql/mongo)
# ============================================================================

APP_NAME=DerBanks
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://CHANGE_ME_IP_ESTATICA_LIGHTSAIL
TIPO_CAMBIO_USD_GTQ=7.65

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----------------------------------------------------------------------------
# MySQL (servicio "mysql" del docker-compose). DB_HOST es el nombre del
# servicio, no 127.0.0.1 -- los contenedores se resuelven por nombre en la
# red interna de Docker Compose.
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ERPTI
DB_USERNAME=erp_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Solo lo consume el servicio mysql del compose (usuario root del contenedor).
DB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# ----------------------------------------------------------------------------
# MongoDB (servicio "mongo" del docker-compose, con auth habilitado).
# MONGO_DSN tiene prioridad sobre HOST/PORT/USER/PASS si se llena (ver
# config/database.php) -- aqui se arma explicito para no depender de eso.
# ----------------------------------------------------------------------------
MONGO_CONNECTION=mongodb
MONGO_ROOT_USERNAME=erp_mongo_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=erpti_audit
MONGO_AUTH_DATABASE=admin
MONGO_DSN=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@mongo:27017/${MONGO_DATABASE}?authSource=admin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# ----------------------------------------------------------------------------
# Redis: no hay contenedor para esto -- CACHE_STORE/QUEUE_CONNECTION arriba
# usan "database", asi que el proyecto no lo necesita hoy. Si en el futuro
# cambian esos dos valores a "redis", ahi si hay que agregar el servicio al
# docker-compose.yml.
# ----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
